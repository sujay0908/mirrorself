# ─── MirrorSelf environment ───────────────────────────────────────────────
# Copy this file to `.env` (in the project root) and fill in real values.
# Never commit your real `.env` to source control.

# ─── App ──────────────────────────────────────────────────────────────────
APP_NAME=MirrorSelf
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost"]

# ─── Security ─────────────────────────────────────────────────────────────
# Generate with: `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SECRET_KEY=change-me-in-production-please-use-a-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mirrorself:mirrorself@localhost:5432/mirrorself
DATABASE_URL_SYNC=postgresql://mirrorself:mirrorself@localhost:5432/mirrorself

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MEMORY_TTL=2592000

# ─── Anthropic Claude ─────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=1024

# ─── Supabase ──────────────────────────────────────────────────────────────
# Create project at https://supabase.com, then add keys from Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Optional: JWKS URL for local JWT verification in production (derived from SUPABASE_URL)
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# â”€â”€â”€ Google Cloud / Firebase Storage â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
GCP_PROJECT_ID=your-gcp-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_STORAGE_URL_MODE=firebase_token
STORAGE_URL_TTL_SECONDS=3600
STORAGE_FACE_PREFIX=face-photos
STORAGE_VOICE_SAMPLES_PREFIX=voice-samples
STORAGE_VOICE_OUTPUT_PREFIX=voice-output
STORAGE_AVATARS_PREFIX=avatars

# ─── XTTS-v2 ──────────────────────────────────────────────────────────────
XTTS_MODEL_DIR=./models/xtts
XTTS_DEVICE=cpu
XTTS_SAMPLE_RATE=24000
VOICE_SAMPLES_DIR=./storage/voice_samples
VOICE_OUTPUT_DIR=./storage/voice_output

# ─── SadTalker ────────────────────────────────────────────────────────────
SADTALKER_DIR=./models/SadTalker
SADTALKER_CHECKPOINTS=./models/SadTalker/checkpoints
SADTALKER_DEVICE=cpu
AVATAR_OUTPUT_DIR=./storage/avatars
FACE_PHOTOS_DIR=./storage/face_photos

# ─── Storage ──────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=50

# ─── Frontend ─────────────────────────────────────────────────────────────
# Used by Next.js route handlers to reach the backend.
# Format: http(s)://backend-host/api (must include /api prefix)
# Local dev: http://localhost:8000/api
# Docker: http://backend:8000/api
API_INTERNAL_URL=http://backend:8000/api
NEXT_PUBLIC_API_BASE=/api
# Base URL used when building public twin share links.
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_HOSTNAME=localhost

# ─── Cloudflare Tunnel (optional) ─────────────────────────────────────────
# Create a tunnel at https://one.dash.cloudflare.com -> Zero Trust -> Tunnels,
# then paste the token here. Run with: docker compose --profile tunnel up.
TUNNEL_TOKEN=
