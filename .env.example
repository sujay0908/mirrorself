# Copy to .env for local dev. NEVER commit the real .env.
# All variables are documented at apps/api/app/config.py.

# ---- Runtime ----
APP_ENV=dev                          # dev | staging | prod
LOG_LEVEL=INFO

# ---- Database ----
# For local dev via docker-compose the URL below points at the compose Postgres.
# For tests we override to a sqlite+aiosqlite in-memory database.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# ---- Supabase Auth ----
# Verify JWTs against this JWKS URL. For local dev with Supabase local this is
# usually http://localhost:54321/auth/v1/.well-known/jwks.json .
SUPABASE_JWT_JWKS_URL=
# Optional: audience claim to enforce.
SUPABASE_JWT_AUDIENCE=authenticated
# Optional shortcut for local dev only: verify HS256 tokens with this secret
# instead of hitting JWKS. Leave blank in prod.
SUPABASE_JWT_HS_SECRET=

# ---- LLM ----
# Provider registry key. Must match a provider registered in app/llm/registry.py.
LLM_PROVIDER=mock                    # mock | anthropic | openai | local
# Model identifier passed straight through to the provider.
LLM_MODEL=mock-echo                  # e.g. claude-sonnet-4-5-20250929
# Provider secrets. Only the ones matching LLM_PROVIDER need to be set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Embeddings ----
# Sprint 2: embedding is best-effort. Confirmation always succeeds even if
# the provider is misconfigured or offline. `openai` requires OPENAI_API_KEY.
EMBEDDING_PROVIDER=mock              # mock | openai
EMBEDDING_MODEL=mock-embed-1
EMBEDDING_DIMENSIONS=1536            # per-row in memory_embeddings;
                                     # not a domain-level constant

# ---- CORS ----
CORS_ALLOW_ORIGINS=http://localhost:8081,http://localhost:19006

# ---- Mobile (Expo) ----
# Prefixed with EXPO_PUBLIC_ so they are bundled into the client.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
