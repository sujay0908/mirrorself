# Frontend env. Copy to `.env.local` (or just `.env` in Next.js).
# Used by the Next.js dev server and Docker build.

# Supabase Auth (get these from https://supabase.com Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Where the browser should send API requests. Default `/api` is rewritten
# to the backend by the catch-all route handler.
NEXT_PUBLIC_API_BASE=/api

# Where the server-side route handlers reach the backend.
# Must include /api at the end.
# Local dev: http://localhost:8000/api
# Docker: http://backend:8000/api
# Production: https://api.yourdomain.com/api (Cloud Run)
API_INTERNAL_URL=http://localhost:8000/api
