# Frontend env. Copy to `.env.local`.
# Used by the Next.js dev server and Docker build.

# Where the browser should send API requests. The default `/api` is rewritten
# to the backend by the catch-all route handler.
NEXT_PUBLIC_API_BASE=/api

# Where the server-side route handlers reach the backend.
# In docker compose this is `http://backend:8000`; for local dev use
# `http://localhost:8000`.
API_INTERNAL_URL=http://localhost:8000
